digraph cluster_05 {
graph [compound=true,rankdir=LR];
node [shape=box];
subgraph cluster_ingest { label="ingest 5"; api; queue; api -> queue; }
subgraph cluster_compute { label="compute 5"; subgraph cluster_inner { label="inner"; worker; validate; worker -> validate; } }
queue -> worker [ltail=cluster_ingest,lhead=cluster_compute];
validate -> result;
}
