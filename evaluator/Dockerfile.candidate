FROM gcc@sha256:9188ac751ca24431dc43dbd142a223c98ea74f01d2858e84d30ba342a0d67844 AS build
RUN groupadd --gid 10001 solver && useradd --uid 10001 --gid 10001 --home-dir /home/solver --create-home solver
WORKDIR /workspace
COPY --chown=10001:10001 . /workspace/
RUN chown 10001:10001 /workspace
USER solver
RUN /bin/sh /workspace/compile.sh && test -x /workspace/build/dot

FROM gcc@sha256:9188ac751ca24431dc43dbd142a223c98ea74f01d2858e84d30ba342a0d67844
RUN groupadd --gid 10001 solver && useradd --uid 10001 --gid 10001 --home-dir /home/solver --create-home solver
WORKDIR /workspace
COPY --from=build --chown=10001:10001 /workspace/ /workspace/
USER solver
